                                        <small class="text-muted">${new Date(notification.createdAt).toLocaleString()}</small>
                                    </div>
                                    <p class="mb-1 small">${notification.message}</p>
                                    ${notification.relatedEntityType === 'Alert' ? `
                                        <div class="mt-1">
                                            ${notification.affectedArea ? `<small class="text-muted d-block">Affected Area: ${notification.affectedArea}</small>` : ''}
                                            ${notification.issuedBy ? `<small class="text-muted d-block">Issued by: ${notification.issuedBy}</small>` : ''}
                                            <div class="d-flex gap-2">
                                                <button onclick="scrollToAlert(${notification.relatedEntityId})" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>View Alert
                                                </button>
                                                <button onclick="markAlertAsRead(${notification.relatedEntityId})" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-check me-1"></i>Mark as Read
                                                </button>
                                            </div>
                                        </div>
                                    ` : notification.relatedEntityType === 'Report' ? `
                                        <div class="mt-1">
                                            <div class="d-flex gap-2">
                                                <a href="/Community/ReportDetails/${notification.relatedEntityId}" class="btn btn-sm btn-outline-primary" onclick="markAsRead(${notification.id})">
                                                    <i class="fas fa-eye me-1"></i>View Report
                                                </a>
                                                <button onclick="markAsRead(${notification.id})" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fas fa-check me-1"></i>Mark as Read
