        // Function to load existing alerts
        async function loadExistingAlerts() {
            try {
                const response = await fetch('/Community/GetRecentAlerts');
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const alerts = await response.json();
                console.log('Loaded existing alerts:', alerts);
                // Update your alerts UI here
            } catch (error) {
                console.error('Error loading existing alerts:', error);
            }
