        }

        // Create debounced version of loadNotifications
        const debouncedLoadNotifications = debounce(loadNotifications, 300);

        // Initialize SignalR connection
        async function initializeSignalR() {
            try {
                // Initialize both community and alert hubs
                const communityConn = new signalR.HubConnectionBuilder()
                    .withUrl("/communityHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                    .configureLogging(signalR.LogLevel.Debug)
                    .build();

                const alertConn = new signalR.HubConnectionBuilder()
                    .withUrl("/alertHub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                    .configureLogging(signalR.LogLevel.Debug)
                    .build();

                // Set up community hub event handlers
                communityConn.onreconnecting(error => {
                    console.log('Reconnecting to CommunityHub...', error);
                    showToastNotification(
                        "Connection Lost",
                        "Attempting to reconnect to community updates...",
                        "warning"
                    );
                });

                communityConn.onreconnected(connectionId => {
                    console.log('Reconnected to CommunityHub:', connectionId);
                    showToastNotification(
                        "Connection Restored",
                        "Community updates are now active",
                        "success"
                    );
                    const userId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
                    if (userId) {
                        communityConn.invoke("JoinUserGroup", userId)
                            .then(() => {
                                console.log('Rejoined community user group:', userId);
                                debouncedLoadNotifications();
                            })
                            .catch(err => {
                                console.error('Error rejoining community group:', err);
                                showToastNotification(
                                    "Connection Error",
                                    "Failed to restore community updates",
                                    "warning"
                                );
                            });
                    }
                });

                communityConn.onclose(error => {
                    console.log('CommunityHub connection closed:', error);
                    showToastNotification(
                        "Connection Lost",
                        "Lost connection to community updates",
                        "warning"
                    );
                });

                // Handle post moderation updates
                communityConn.on("PostModerationUpdate", function(data) {
                    console.log("Post moderation update received:", data);
                    
                    // Generate a unique key for this post update
                    const postUpdateKey = `post-update-${data.postId}`;
                    
                    // Initialize tracking variables if not exists
                    if (!window.processedPostUpdates) {
                        window.processedPostUpdates = new Set();
                    }
                    
                    if (!window.processedPostNotifications) {
                        window.processedPostNotifications = new Map();
                    }
                    
                    // Check if we've already processed this exact post update
                    if (window.processedPostUpdates.has(postUpdateKey)) {
                        console.log("Skipping duplicate post update:", postUpdateKey);
                        return;
                    }
                    
                    // If there's an existing notification for this post in the dropdown, remove it
                    const existingNotifications = document.querySelectorAll(`.notification-item[data-entity-type="CommunityPost"][data-entity-id="${data.postId}"]`);
                    if (existingNotifications.length > 0) {
                        console.log(`Found and removing ${existingNotifications.length} existing notifications for post ID ${data.postId}`);
                        existingNotifications.forEach(item => item.remove());
                    }
                    
                    // Mark this post update as processed
                    window.processedPostUpdates.add(postUpdateKey);
                    
                    // Format the date correctly
                    let timestamp;
                    try {
                        timestamp = new Date(data.timestamp);
                        if (isNaN(timestamp.getTime())) {
                            console.warn("Invalid timestamp received:", data.timestamp);
                            timestamp = new Date(); // Use current time as fallback
                        }
                    } catch (e) {
                        console.error("Error parsing timestamp:", e);
                        timestamp = new Date(); // Use current time as fallback
                    }
                    
                    // Store the formatted timestamp to ensure consistent date display
                    const formattedTimestamp = timestamp.toISOString();
                    
                    // Add this post ID to our map of processed posts 
                    window.processedPostNotifications.set(data.postId.toString(), {
                        timestamp: timestamp,
                        formattedTimestamp: formattedTimestamp,
                        processed: true
                    });
                    
                    // Create notification object with consistent date format
                    const notification = {
                        id: `post-${data.postId}-${Date.now()}`, // Create a unique ID based on post ID and current time
                        title: data.isApproved ? "Post Approved" : "Post Rejected",
                        message: data.isApproved ? 
                            "Your community post has been approved and is now visible in the community feed." :
                            (data.reason ? `Your post was rejected. Reason: ${data.reason}` : "Your post was rejected."),
                        notificationType: data.isApproved ? "success" : "warning",
                        createdAt: formattedTimestamp, // Use ISO string format for consistent date handling
                        relatedEntityType: "CommunityPost",
                        relatedEntityId: data.postId
                    };
                    
                    console.log("Created notification with date:", formattedTimestamp);
                    
                    // Handle the notification
                    handleNewNotification(notification);
                    
                    // Force a reload of the notifications from server (after a small delay)
                    setTimeout(() => {
                        console.log("Forcing notification reload after post update");
                        loadNotifications();
                    }, 2000);
                });

                // Handle general notifications
                communityConn.on("NotificationReceived", function(notification) {
                    console.log("New notification received:", notification);
                    
                    // Skip if this is an alert notification (it will be handled by ReceiveAlert)
                    if (notification.relatedEntityType === "Alert") {
                        console.log("Skipping alert notification in NotificationReceived as it will be handled by ReceiveAlert");
                        return;
                    }
                    
                    // Create a unique identifier for this notification that includes both the ID and entity info
                    let notificationKey = notification.id;
                    
                    // For post notifications, create a key that identifies the specific post update
                    if (notification.relatedEntityType === "CommunityPost") {
                        const postUpdateKey = `post-update-${notification.relatedEntityId}`;
                        
                        // Check if this post update was already handled by PostModerationUpdate
                        if (window.processedPostUpdates && window.processedPostUpdates.has(postUpdateKey)) {
                            console.log("Skipping duplicate post notification already handled by PostModerationUpdate");
                            return;
                        }
                        
                        // Add a composite key for post notifications
                        notificationKey = `notification-${notification.id}-post-${notification.relatedEntityId}`;
                    } else if (notification.relatedEntityType === "Report") {
                        // Create a key for report notifications
                        notificationKey = `notification-${notification.id}-report-${notification.relatedEntityId}`;
                    }
                    
                    // Store the notification keys in a Set to track what we've shown
                    if (!window.shownNotifications) {
                        window.shownNotifications = new Set();
                    }
                    
                    // Skip if we've already shown this notification
                    if (window.shownNotifications.has(notificationKey)) {
                        console.log("Skipping duplicate notification:", notificationKey);
                        return;
                    }
                    
                    // Add the notification key to our tracking Set
                    window.shownNotifications.add(notificationKey);
                    
                    // Increment notification badge immediately
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        const currentCount = parseInt(badge.textContent || '0');
                        updateNotificationBadge(currentCount + 1);
                    }
                    
                    handleNewNotification(notification);
                    showToastNotification(notification.title, notification.message, notification.notificationType);
                });

                // Handle incident report status updates
                communityConn.on("ReportStatusUpdated", function(reportId, status, title) {
                    console.log('Report status updated:', { reportId, status, title });
                    
                    // Show toast notification
                    let toastType = 'info';
                    let message = '';
                    
                    if (status === 'Resolved') {
                        toastType = 'success';
                        message = `Your report '${title}' has been resolved by CDRRMC.`;
                    } else if (status === 'InProgress') {
                        toastType = 'warning';
                        message = `Your report '${title}' is now being addressed by local authorities.`;
                    } else if (status === 'Verified') {
                        toastType = 'success';
                        message = `Your report '${title}' has been verified and is now being processed.`;
                    } else if (status === 'Assigned') {
                        toastType = 'info';
                        message = `Your report '${title}' has been assigned to CDRRMC and is now being processed.`;
                    } else {
                        message = `Report "${title}" status has been updated to ${status.toLowerCase()}`;
                    }
                    
                    showToastNotification(
                        'Report Status Updated',
                        message,
                        toastType
                    );

                    // Force immediate reload of notifications
                    loadNotifications();
                });

                // Track alerts we've already processed to prevent duplicates
                const processedAlerts = new Set();

                // Handle new alerts
                alertConn.on("ReceiveAlert", function(alert) {
                    console.log("New alert received:", alert);
                    
                    // Skip if null or invalid alert
                    if (!alert || !alert.id) {
                        console.log("Skipping invalid alert");
                        return;
                    }
                    
                    // Create a unique key for this alert
                    const alertKey = `alert-${alert.id}`;
                    
                    // Skip if we've already processed this exact alert recently
                    if (processedAlerts.has(alertKey)) {
                        console.log("Skipping duplicate alert:", alertKey);
                        return;
                    }
                    
                    // Store the alert in our tracking Sets
                    if (!window.shownNotifications) {
                        window.shownNotifications = new Set();
                    }
                    processedAlerts.add(alertKey);
                    window.shownNotifications.add(alert.id);
                    
                    // Remove from processed alerts after 10 seconds to prevent memory leak
                    setTimeout(() => {
                        processedAlerts.delete(alertKey);
                    }, 10000);
                    
                    // Create a notification object for consistent handling
                    const notification = {
                        id: alert.id,
                        title: alert.title,
                        message: `${alert.message}\n\nAffected Area: ${alert.affectedArea}\nIssued by: ${alert.issuedBy}`,
                        notificationType: getSeverityType(alert.severity),
                        createdAt: new Date().toISOString(),
                        relatedEntityType: "Alert",
                        relatedEntityId: alert.id,
                        affectedArea: alert.affectedArea,
                        issuedBy: alert.issuedBy,
                        isRead: false
                    };
                    
                    // Increment badge count immediately
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        const currentCount = parseInt(badge.textContent || '0');
                        updateNotificationBadge(currentCount + 1);
                    }
                    
                    // Handle the notification
                    handleNewNotification(notification);
                    
                    // Show toast notification
                    showToastNotification(
                        alert.title,
                        `${alert.message}\n\nAffected Area: ${alert.affectedArea}\nIssued by: ${alert.issuedBy}`,
                        getSeverityType(alert.severity)
                    );
                    
                    // Play alert sound
                    playNotificationSound('alert');
                    
                    // Force a reload of notifications to get the correct count from server
                    loadNotifications();
                });

                // Start both connections
                try {
                    console.log('Starting CommunityHub connection...');
                    await communityConn.start();
                    console.log('CommunityHub Connected Successfully');

                    console.log('Starting AlertHub connection...');
                    await alertConn.start();
                    console.log('AlertHub Connected Successfully');

                    console.log('Both SignalR connections established');

                    // Join user group for community hub
                const userId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
                if (userId) {
                        await communityConn.invoke("JoinUserGroup", userId);
                        console.log('Joined community user group:', userId);
                    }

                    // Load initial data
                    await Promise.all([
                        debouncedLoadNotifications(),
                        loadExistingAlerts()
                    ]);

                    return { communityConn, alertConn };
            } catch (err) {
                    console.error('Error starting SignalR connections:', err);
                    throw err;
                }
            } catch (err) {
                console.error('SignalR Connection Error:', err);
                showToastNotification(
                    "Connection Error",
                    "Failed to establish real-time connection",
                    "warning"
                );
                // Retry connection after delay
                setTimeout(() => {
                    console.log('Retrying SignalR connection...');
                    initializeSignalR();
                }, 5000);
                throw err;
            }
        }

        // Function to handle new notifications
        function handleNewNotification(notification) {
            const notificationList = document.getElementById('notificationList');
            if (!notificationList) return;

            // Check if this is a post notification and if we already have a notification for this post
            if (notification.relatedEntityType === "CommunityPost") {
                // Find all existing notifications for this post
                const existingNotifications = notificationList.querySelectorAll(`.notification-item[data-post-id="${notification.relatedEntityId}"]`);
                
                // Remove all existing notifications for this post to avoid duplicates
                existingNotifications.forEach(item => {
                    console.log("Removing existing notification for post:", notification.relatedEntityId);
                    item.remove();
                });
            }

            // Create notification item with clear data attributes
            const notificationItem = document.createElement('div');
            notificationItem.className = `dropdown-item notification-item p-3 border-bottom ${notification.isRead ? '' : 'unread'}`;
