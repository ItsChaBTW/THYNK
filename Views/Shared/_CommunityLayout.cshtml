        // Initialize SignalR when the page loads
        document.addEventListener('DOMContentLoaded', async function() {
            // Track processed notifications by their keys
            window.shownNotifications = new Set();
            window.processedPostUpdates = new Set();
            
            // Store the processed post IDs with their latest notification
            window.processedPostNotifications = new Map();
            
            try {
                const { communityConn, alertConn } = await initializeSignalR();
