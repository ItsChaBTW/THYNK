        // Helper function to get severity type for notifications
        function getSeverityType(severity) {
            switch (severity) {
                case 0: return 'info';     // Info
                case 1: return 'warning';  // Warning
                case 2: return 'danger';   // Danger
                case 3: return 'critical'; // Critical
                default: return 'info';
            }
        }

        // Keep track of recent toast notifications to prevent duplicates
        const recentToasts = new Map();

        // Function to show toast notification
        function showToastNotification(title, message, type = 'info') {
            // Create a unique key for this toast that includes more details for alerts
            let toastKey = `${title}-${type}`;
            
            // For alerts, include more details in the key to prevent duplicates
            if (type === 'info' || type === 'warning' || type === 'danger' || type === 'critical') {
                // Extract affected area and issued by from message if present
                const affectedAreaMatch = message.match(/Affected Area: (.*?)(?:\n|$)/);
                const issuedByMatch = message.match(/Issued by: (.*?)(?:\n|$)/);
                
                if (affectedAreaMatch || issuedByMatch) {
                    toastKey = `${title}-${type}-${affectedAreaMatch ? affectedAreaMatch[1] : ''}-${issuedByMatch ? issuedByMatch[1] : ''}`;
                }
            }
            
            // Check if we've shown this toast recently (within 5 seconds)
            if (recentToasts.has(toastKey)) {
                console.log('Skipping duplicate toast:', toastKey);
                return;
            }
            
            // Add to recent toasts map
            recentToasts.set(toastKey, Date.now());
            
            // Remove old entries after 5 seconds to clean up memory
            setTimeout(() => {
                recentToasts.delete(toastKey);
            }, 5000);
            
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `toast-notification ${type}`;
            
            // Get appropriate icon based on type
            let icon = 'info-circle';
            if (type === 'success') icon = 'check-circle';
            else if (type === 'warning') icon = 'exclamation-circle';
            else if (type === 'danger') icon = 'exclamation-triangle';
            else if (type === 'critical') icon = 'radiation';
            
            toast.innerHTML = `
                <div class="toast-header">
                    <i class="fas fa-${icon}"></i>
                    <strong class="ms-2">${title}</strong>
                </div>
                <div class="toast-body">
                    ${message}
                </div>
            `;
            document.body.appendChild(toast);

            // Remove toast after 5 seconds
            setTimeout(() => {
                toast.classList.add('hide');
                setTimeout(() => toast.remove(), 300);
            }, 5000);
        }

        // Function to update notification badge
        function updateNotificationBadge(count) {
            const badge = document.getElementById('notificationBadge');
            if (!badge) {
                console.warn('Notification badge element not found');
                return;
            }
            
            // Ensure count is a valid number
            const safeCount = Math.max(0, parseInt(count) || 0);
            
            // Get current count for comparison
            const currentCount = parseInt(badge.textContent || '0');
            
            console.log(`Updating badge count: ${currentCount} → ${safeCount}`);
            
            // Only update if the count has actually changed
            if (currentCount !== safeCount) {
                // Update the text content
                badge.textContent = safeCount;
                
                if (safeCount > 0) {
                    // Make sure badge is visible
                    badge.style.display = 'flex';
                    
                    // Add appropriate animation
                    if (safeCount > currentCount) {
                        // New notification - bounce in
                        badge.classList.remove('animate__bounceIn', 'animate__pulse', 'animate__fadeOut');
                        void badge.offsetWidth; // Force reflow
                        badge.classList.add('animate__animated', 'animate__bounceIn');
                    } else if (safeCount < currentCount) {
                        // Notification read - pulse
                        badge.classList.remove('animate__bounceIn', 'animate__pulse', 'animate__fadeOut');
                        void badge.offsetWidth; // Force reflow
                        badge.classList.add('animate__animated', 'animate__pulse');
                    }
                    
                    // Remove animation classes after animation completes
                    setTimeout(() => {
                        badge.classList.remove('animate__animated', 'animate__bounceIn', 'animate__pulse', 'animate__fadeOut');
                    }, 1000);
                } else {
                    // No unread notifications - fade out and hide
                    badge.classList.remove('animate__bounceIn', 'animate__pulse');
                    void badge.offsetWidth; // Force reflow
                    badge.classList.add('animate__animated', 'animate__fadeOut');
                    
                    // Hide the badge after animation completes
                    setTimeout(() => {
                        badge.style.display = 'none';
                        badge.classList.remove('animate__animated', 'animate__fadeOut');
                    }, 300);
                }
            }
        }

        // Function to update community feed

        // Function to update community feed
        function updateCommunityFeed(data) {
            const feedContainer = document.querySelector('.community-feed');
            if (!feedContainer) return;

            // Update the feed content with new data
            // This will depend on your feed structure
            feedContainer.innerHTML = data.html; // Assuming the server returns HTML
        }

        // Add function to load alert count
        async function loadAlertCount() {
            try {
                const response = await fetch('/Community/GetAlertCount');
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const data = await response.json();
                updateAlertBadge(data.count);
            } catch (error) {
                console.error('Error loading alert count:', error);
            }
        }

        // Call loadAlertCount when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadAlertCount();
        });

        // Add click handler for mark all as read
        document.getElementById('markAllRead').addEventListener('click', async function() {
            try {
                const response = await fetch('/Community/MarkAllNotificationsAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    updateNotificationBadge(0);
                    debouncedLoadNotifications();
                }
            } catch (error) {
                console.error('Error marking notifications as read:', error);
            }
        });

        // Add this new function to mark notifications as read
        async function markAsRead(notificationId) {
            try {
                console.log('Marking notification as read:', notificationId);
                const response = await fetch('/Community/MarkNotificationAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ notificationId })
                });
                
                console.log('Response status:', response.status);
                const data = await response.json();
                console.log('Response data:', data);
                
                if (response.ok && data.success) {
                    // Update the notification count
                    console.log('Updating badge count to:', data.unreadCount);
                    updateNotificationBadge(data.unreadCount);
                    
                    // Update the notification list
                    console.log('Reloading notifications');
                    await loadNotifications();
                    
                    // Remove unread class from the notification item
                    const notificationItem = document.querySelector(`.notification-item[data-id="${notificationId}"]`);
                    if (notificationItem) {
                        notificationItem.classList.remove('unread');
                    }
                } else {
                    console.error('Failed to mark notification as read:', data);
                }
            } catch (error) {
                console.error('Error marking notification as read:', error);
            }
        }
        
        // Function to mark notification as read and then navigate to a URL
        async function markAsReadAndNavigate(notificationId, url) {
            try {
                console.log('Marking notification as read and navigating to:', url);
                const response = await fetch('/Community/MarkNotificationAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ notificationId })
                });
                
                const data = await response.json();
                
                if (response.ok && data.success) {
                    // Update the notification count
                    const badge = document.getElementById('notificationBadge');
                    const currentCount = parseInt(badge?.textContent || '0');
                    if (currentCount > 0) {
                        updateNotificationBadge(currentCount - 1);
                    }
                    
                    // Remove unread class from notification item
                    const notificationItem = document.querySelector(`.notification-item[data-id="${notificationId}"]`);
                    if (notificationItem) {
                        notificationItem.classList.remove('unread');
                    }
                    
                    // Close the dropdown if it's open
                    const dropdown = document.querySelector('.dropdown-menu.show');
                    if (dropdown) {
                        dropdown.classList.remove('show');
                    }
                }
                
                // Navigate to the URL
                window.location.href = url;
            } catch (error) {
                console.error('Error marking notification as read:', error);
                // Still navigate to the URL even if there was an error
                window.location.href = url;
            }
        }

        // Function to mark alert as read
        async function markAlertAsRead(alertId) {
            try {
                console.log('Marking alert as read:', alertId);
                const response = await fetch('/Community/MarkAlertAsRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ alertId })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        // Update badge count with the server's count
                        updateNotificationBadge(data.unreadCount);
                        
                        // Update notification item in the list
                        const notificationItem = document.querySelector(`.notification-item[data-entity-type="Alert"][data-entity-id="${alertId}"]`);
                        if (notificationItem) {
                            notificationItem.classList.remove('unread');
                        }
                        
                        // Close the dropdown if it's open
                        const dropdown = document.querySelector('.dropdown-menu.show');
                        if (dropdown) {
                            dropdown.classList.remove('show');
                        }
                    }
                }
            } catch (error) {
                console.error('Error marking alert as read:', error);
            }
        }

        // Function to scroll to alert in feed
        function scrollToAlert(alertId) {
            // Check if we're on the Community Feed page
            if (!window.location.pathname.includes('/Community/CommunityFeed')) {
                // If not on Community Feed, redirect there with the alert ID
                window.location.href = `/Community/CommunityFeed?alertId=${alertId}`;
                return;
            }

            // Close the notification dropdown
            const dropdown = document.querySelector('.dropdown-menu.show');
            if (dropdown) {
                dropdown.classList.remove('show');
            }

            // Wait for the feed to load and then scroll to the alert
            const checkForAlert = setInterval(() => {
                const alertElement = document.querySelector(`.post-card[data-post-id="${alertId}"][data-post-type="Alert"]`);
                if (alertElement) {
                    clearInterval(checkForAlert);
                    
                    // Mark the alert as read
                    markAlertAsRead(alertId);
                    
                    // Scroll to the alert with smooth animation
                    alertElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    
                    // Add highlight effect
                    alertElement.classList.add('highlight-alert');
                    setTimeout(() => {
                        alertElement.classList.remove('highlight-alert');
                    }, 2000);
                    
                    // Remove the alertId from URL without refreshing
                    window.history.replaceState({}, document.title, window.location.pathname);
                }
            }, 100); // Check every 100ms

            // Stop checking after 5 seconds to prevent infinite loop
            setTimeout(() => {
                clearInterval(checkForAlert);
            }, 5000);
        }

        // Add highlight animation style
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes highlightAlert {
                0% {
                    background-color: rgba(220, 53, 69, 0.1);
                    transform: scale(1);
                }
                50% {
                    background-color: rgba(220, 53, 69, 0.2);
                    transform: scale(1.01);
                }
                100% {
                    background-color: transparent;
                    transform: scale(1);
                }
            }

            .highlight-alert {
                animation: highlightAlert 2s ease-in-out;
                border: 2px solid #dc3545;
            }
        `;
        document.head.appendChild(style);

        // Function to show alert notification in dropdown
        function showAlertNotification(alert, isNew = true) {
            const notificationList = document.getElementById('notificationList');
            if (!notificationList) return;

            // Create notification item
            const notificationItem = document.createElement('div');
            notificationItem.className = 'dropdown-item notification-item p-3 border-bottom unread';
            notificationItem.dataset.id = `alert-${alert.id}`;
            notificationItem.dataset.entityType = 'Alert';
            notificationItem.dataset.entityId = alert.id;

            // Get severity icon and color
            let iconType = 'bell text-primary';
            let severityText = getSeverityText(alert.severity);
            let severityClass = getSeverityBadgeClass(alert.severity);

            // Format the date
            const date = new Date(alert.dateIssued);
            const formattedDate = date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            }) + ' ' + date.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false
            });

            notificationItem.innerHTML = `
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 mt-1">
                        <i class="fas fa-${iconType}"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="mb-1">${isNew ? 'New Alert: ' : ''}${alert.title}</h6>
                            <small class="text-muted">${formattedDate}</small>
                        </div>
                        <p class="mb-1 small">${alert.message}</p>
                        <div class="d-flex align-items-center mt-2">
                            <span class="badge ${severityClass} me-2">${severityText}</span>
                            <button onclick="scrollToAlert(${alert.id})" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye me-1"></i>View Alert
                            </button>
                        </div>
                    </div>
                </div>
            `;

            // Add to top of notification list
            if (notificationList.firstChild) {
                notificationList.insertBefore(notificationItem, notificationList.firstChild);
            } else {
                notificationList.appendChild(notificationItem);
            }

            // Update notification badge
            const badge = document.getElementById('notificationBadge');
            if (badge) {
                const currentCount = parseInt(badge.textContent || '0');
                badge.textContent = currentCount + 1;
                badge.style.display = 'flex';
            }

            // Show toast notification only for new alerts
            if (isNew) {
                showToastNotification(
                    alert.title,
                    `${alert.message}\n\nAffected Area: ${alert.affectedArea}`,
                    getSeverityType(alert.severity)
                );
            }

            // Force a reload of notifications to get the correct count from server
            loadNotifications();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-lg shadow-lg border-0">
                <div class="modal-header border-bottom border-gray-100">
                    <h5 class="modal-title font-medium" style="color: var(--sidebar-bg);" id="logoutConfirmModalLabel">
                        Confirm Logout
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-dark-alt mb-0">Are you sure you want to log out of your account?</p>
                </div>
                <div class="modal-footer border-top border-gray-100">
                    <button type="button" class="btn rounded-pill px-4 text-white" style="background-color: var(--success);" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" id="confirmLogoutBtn" class="btn rounded-pill px-4 text-white" style="background-color: var(--danger);">
                        Logout
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Logout Form (Hidden) -->
    <form id="logoutForm" class="d-none" action="/Identity/Account/Logout" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="~/" />
    </form>
    
    <!-- Report Submission Success Modal -->
    <div class="modal fade" id="reportSubmissionModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="reportSubmissionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-lg overflow-hidden">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title" id="reportSubmissionModalLabel">
                        <i class="fas fa-check-circle me-2"></i>Report Submitted Successfully
                    </h5>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <div class="success-icon bg-success bg-opacity-10 text-success mx-auto mb-4" style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-check-circle fa-3x"></i>
                        </div>
                        
                        <h4 class="mt-4 mb-2 text-success">Thank You!</h4>
                        <p class="mb-3">Your incident report has been successfully submitted.</p>
                        <p class="small text-muted">Our team will review your report and take appropriate action.</p>
                        
                        <div class="report-info mt-4 text-start bg-light p-3 rounded">
                            @if (TempData["ReportId"] != null)
                            {
                                <p class="mb-2"><strong>Report ID:</strong> <span id="reportIdValue">@TempData["ReportId"]</span></p>
                            }
                            @if (TempData["ReportTitle"] != null)
                            {
                                <p class="mb-2"><strong>Title:</strong> @TempData["ReportTitle"]</p>
                            }
                            @if (TempData["ReportType"] != null)
                            {
                                <p class="mb-0"><strong>Type:</strong> @TempData["ReportType"]</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0">
                    <a href="@Url.Action("MyReports", "Community")" class="btn btn-outline-secondary">
                        <i class="fas fa-clipboard-list me-2"></i>View My Reports
                    </a>
                    <a href="@Url.Action("CommunityFeed", "Community")" class="btn btn-success px-4">
                        <i class="fas fa-home me-2"></i>Return to Feed
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Logout confirmation handling
        document.addEventListener('DOMContentLoaded', function() {
            // Check for report submission
            @if (TempData.ContainsKey("ReportSubmitted") && (bool)TempData["ReportSubmitted"] == true)
            {
                <text>
                try {
                    const reportModal = new bootstrap.Modal(document.getElementById('reportSubmissionModal'));
                    reportModal.show();
                } catch (e) {
                    console.error("Error showing report modal:", e);
                }
                </text>
            }
            
            // Get all logout buttons
            const logoutBtns = document.querySelectorAll('[data-logout-trigger]');
            const logoutModal = document.getElementById('logoutConfirmModal');
            const confirmLogoutBtn = document.getElementById('confirmLogoutBtn');
            const logoutForm = document.getElementById('logoutForm');
            
            // Initialize Bootstrap modal
            let bootstrapModal = null;
            try {
                bootstrapModal = new bootstrap.Modal(logoutModal);
            } catch (e) {
                console.error("Error initializing logout modal:", e);
            }
            
            // Add click event to all logout buttons
            logoutBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (bootstrapModal) {
                        bootstrapModal.show();
                    } else {
                        // Fallback if bootstrap modal isn't available
                        console.log("Modal not available, submitting form directly");
                        logoutForm.submit();
                    }
                });
            });
            
            // Confirm logout button event
            confirmLogoutBtn.addEventListener('click', function() {
                logoutForm.submit();
            });
        });
    </script>

