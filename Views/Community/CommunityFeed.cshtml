@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Add a utility function for consistent date formatting
            function formatLocalDateTime(dateString) {
                try {
                    // Parse the date string
                    const date = new Date(dateString);
                    
                    // Format the date using local timezone
                    return date.toLocaleString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: 'numeric',
                        minute: '2-digit',
                        hour12: true,
                        timeZone: 'Asia/Manila'  // Use Philippine timezone
                    });
                } catch (error) {
                    console.error('Error formatting date:', error);
                    return dateString;
                }
            }

            // Check for alertId in URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const alertId = urlParams.get('alertId');
            const postId = urlParams.get('postId');
            
            if (alertId) {
                // Wait for the feed to load completely
                const checkForAlert = setInterval(() => {
                    const alertElement = document.querySelector(`.post-card[data-post-id="${alertId}"][data-post-type="Alert"]`);
                    if (alertElement) {
                        clearInterval(checkForAlert);
                        // Scroll to the alert with smooth animation
                        alertElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Add highlight effect
                        alertElement.classList.add('highlight-alert');
                        setTimeout(() => {
                            alertElement.classList.remove('highlight-alert');
                        }, 2000);
                        // Remove the alertId from URL without refreshing
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }
                }, 100); // Check every 100ms

                // Stop checking after 5 seconds to prevent infinite loop
                setTimeout(() => {
                    clearInterval(checkForAlert);
                }, 5000);
            } else if (postId) {
                // Wait for the feed to load completely
                const checkForPost = setInterval(() => {
                    const postElement = document.querySelector(`.post-card[data-post-id="${postId}"]`);
                    if (postElement) {
                        clearInterval(checkForPost);
                        // Scroll to the post with smooth animation
                        postElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        // Add highlight effect
                        postElement.classList.add('highlight-alert');
                        setTimeout(() => {
                            postElement.classList.remove('highlight-alert');
                        }, 2000);
                        // Remove the postId from URL without refreshing
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }
                }, 100); // Check every 100ms

                // Stop checking after 5 seconds to prevent infinite loop
                setTimeout(() => {
                    clearInterval(checkForPost);
                }, 5000);
            }
            
            // Create audio element for alert sound
            const alertSound = new Audio('/sounds/notification.mp3');
            // Preload the sound
            alertSound.load();

            // Function to play alert sound
            async function playAlertSound() {
                try {
                    // Reset the audio to the beginning
                    alertSound.currentTime = 0;
                    // Play the sound
                    await alertSound.play();
                } catch (error) {
                    console.log("Error playing sound:", error);
                }
            }

            // Initialize SignalR connection to AlertHub
            const alertConnection = new signalR.HubConnectionBuilder()
                .withUrl("/alertHub")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // Load existing alerts into notifications
            function loadExistingAlerts() {
                fetch('/LGU/GetRecentAlerts')
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data && data.success && Array.isArray(data.alerts)) {
                            console.log('=== PAGE REFRESH: Loading existing alerts ===');
                            console.log('Raw alerts data:', data.alerts);
                            data.alerts.forEach(alert => {
                                if (alert && typeof alert === 'object') {
                                    console.log('PAGE REFRESH - Alert organization info:', {
                                        alertId: alert.id,
                                        organizationName: alert.organizationName,
                                        issuedBy: alert.issuedBy,
                                        userOrg: alert.user?.OrganizationName,
                                        fullAlert: alert
                                    });
                                    showAlertNotification(alert, false); // false means don't play sound
                                }
                            });
                        } else {
                            console.warn('Received invalid alert data:', data);
                        }
                    })
                    .catch(error => {
                        console.error('Error loading existing alerts:', error);
                    });
            }

            // Handle new alerts
            alertConnection.on("ReceiveAlert", function(alert) {
                console.log('=== REAL-TIME: New alert received ===');
                console.log('Raw alert data:', alert);
                
                // Validate the alert object
                if (!alert || typeof alert !== 'object') {
                    console.warn("Received invalid alert data:", alert);
                    return;
                }

                // Check for required properties
                if (!alert.id || !alert.title || !alert.message) {
                    console.warn("Alert missing required properties:", alert);
                    return;
                }

                // Log the organization information for debugging
                console.log("REAL-TIME - Alert organization info:", {
                    alertId: alert.id,
                    organizationName: alert.organizationName,
                    issuedBy: alert.issuedBy,
                    userOrg: alert.user?.OrganizationName,
                    fullAlert: alert
                });

                // Get the organization name with proper fallbacks
                const organizationName = alert.organizationName || 
                                      alert.issuedBy || 
                                      (alert.user && alert.user.OrganizationName) || 
                                      "Organization";

                console.log("REAL-TIME - Resolved organization name:", organizationName);

                // Store the organization name in the alert object for other functions to use
                alert.displayOrganizationName = organizationName;

                // Check if this alert already exists in the feed
                const existingAlert = document.querySelector(`.post-card[data-post-id="${alert.id}"][data-post-type="Alert"]`);
                if (existingAlert) {
                    console.log("Alert already exists in feed, updating instead:", alert.id);
                    updateAlertInFeed(existingAlert, alert);
                    return;
                }
                
                // Play alert sound for new alerts
                playAlertSound();
                
                // Ensure severity is properly set
                if (alert.severity === undefined || alert.severity === null) {
                    alert.severity = 1; // Default to Warning if not specified
                }
                
                addAlertToFeed(alert);

                // Show notification in dropdown
                showAlertNotification(alert, true); // true means play sound
            });

            // Function to show alert notification in dropdown
            function showAlertNotification(alert, isNew = true) {
                const notificationList = document.getElementById('notificationList');
                if (!notificationList) {
                    console.warn('Notification list element not found');
                    return;
                }

                // Validate alert object
                if (!alert || typeof alert !== 'object') {
                    console.error('Invalid alert object:', alert);
                    return;
                }

                // Ensure required properties exist
                if (!alert.id || !alert.title || !alert.message) {
                    console.error('Alert missing required properties:', alert);
                    return;
                }

                // Create notification item
                const notificationItem = document.createElement('div');
                notificationItem.className = 'dropdown-item notification-item p-3 border-bottom unread';
                notificationItem.dataset.id = `alert-${alert.id}`;

                // Get severity icon and color
                let iconType = 'bell text-primary';
                let severityText = getSeverityText(alert.severity || 1);
                let severityClass = getSeverityBadgeClass(alert.severity || 1);

                // Format the date using the utility function
                const formattedDate = formatLocalDateTime(alert.dateIssued);

                notificationItem.innerHTML = `
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0 mt-1">
                            <i class="fas fa-${iconType}"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="mb-1">${isNew ? 'New Alert: ' : ''}${alert.title}</h6>
                                <small class="text-muted">${formattedDate}</small>
                            </div>
                            <p class="mb-1 small">${alert.message}</p>
                            <div class="d-flex align-items-center mt-2">
                                <span class="badge ${severityClass} me-2">${severityText}</span>
                                <button onclick="scrollToAlert(${alert.id})" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>View Alert
                                </button>
                            </div>
                        </div>
                    </div>
                `;

                // Add to top of notification list
                if (notificationList.firstChild) {
                    notificationList.insertBefore(notificationItem, notificationList.firstChild);
                } else {
                    notificationList.appendChild(notificationItem);
                }

                // Update notification badge
                const badge = document.getElementById('notificationBadge');
                if (badge) {
                    const currentCount = parseInt(badge.textContent || '0');
                    badge.textContent = currentCount + 1;
                    badge.style.display = 'flex';
                }

                // Show toast notification only for new alerts
                if (isNew) {
                    showToastNotification(
                        'New Alert',
                        `${alert.title} - ${alert.message}`,
                        'warning'
                    );
                }
            }

            // Function to scroll to alert in feed
            function scrollToAlert(alertId) {
                const alertElement = document.querySelector(`.post-card[data-post-id="${alertId}"][data-post-type="Alert"]`);
                if (alertElement) {
                    // Close the notification dropdown
                    const dropdown = document.querySelector('.dropdown-menu.show');
                    if (dropdown) {
                        dropdown.classList.remove('show');
                    }

                    // Scroll to the alert with smooth animation
                    alertElement.scrollIntoView({ behavior: 'smooth', block: 'center' });

                    // Add highlight effect
                    alertElement.classList.add('highlight-alert');
                    setTimeout(() => {
                        alertElement.classList.remove('highlight-alert');
                    }, 2000);
                }
            }

            // Handle alert updates
            alertConnection.on("AlertUpdated", function(alert) {
                console.log("Alert updated:", alert);
                const existingAlert = document.querySelector(`.post-card[data-post-id="${alert.id}"][data-post-type="Alert"]`);
                if (existingAlert) {
                    updateAlertInFeed(existingAlert, alert);
                }
            });

            // Handle alert deletion
            alertConnection.on("AlertDeleted", function(alertId) {
                console.log("Alert deleted:", alertId);
                const alertElement = document.querySelector(`.post-card[data-post-id="${alertId}"][data-post-type="Alert"]`);
                if (alertElement) {
                    alertElement.remove();
                }
            });

            // Function to add a new alert to the feed
            function addAlertToFeed(alert) {
                const postsContainer = document.getElementById('posts-container');
                if (!postsContainer) {
                    console.warn("Posts container not found");
                    return;
                }

                try {
                    const alertElement = createAlertElement(alert);
                    if (!alertElement) {
                        console.warn("Failed to create alert element");
                        return;
                    }

                    // Check if this alert already exists
                    const existingAlert = document.querySelector(`.post-card[data-post-id="${alert.id}"][data-post-type="Alert"]`);
                    if (existingAlert) {
                        console.log("Alert already exists, skipping:", alert.id);
                        return;
                    }

                    postsContainer.insertBefore(alertElement, postsContainer.firstChild);
                    
                    // Add animation class for new alerts
                    alertElement.classList.add('new-alert');
                    setTimeout(() => {
                        alertElement.classList.remove('new-alert');
                    }, 2000);
                } catch (error) {
                    console.error("Error adding alert to feed:", error);
                }
            }

            // Function to update an existing alert in the feed
            function updateAlertInFeed(alertElement, alert) {
                const newContent = createAlertElement(alert);
                alertElement.replaceWith(newContent);
            }

            // Helper function to get severity text
            function getSeverityText(severity) {
                switch (severity) {
                    case 0: return 'Info';
                    case 1: return 'Warning';
                    case 2: return 'Danger';
                    case 3: return 'Critical';
                    default: return 'Warning';
                }
            }

            // Helper function to get severity class
            function getSeverityClass(severity) {
                switch (severity) {
                    case 0: return 'bg-info';
                    case 1: return 'bg-warning';
                    case 2: return 'bg-danger';
                    case 3: return 'bg-danger';
                    default: return 'bg-warning';
                }
            }

            // Function to create an alert element
            function createAlertElement(alert) {
                if (!alert || !alert.id || !alert.title || !alert.message) {
                    console.warn("Invalid alert data for creating element:", alert);
                    return null;
                }

                try {
                    const div = document.createElement('div');
                    div.className = 'card shadow-sm border-0 mb-4 post-card';
                    div.setAttribute('data-post-type', 'Alert');
                    div.setAttribute('data-post-id', alert.id);

                    // Format the date using the utility function
                    const formattedDate = formatLocalDateTime(alert.dateIssued);

                    // Get the correct badge class based on severity
                    const badgeClass = getSeverityBadgeClass(alert.severity);
                    const severityText = getSeverityText(alert.severity);

                    // Check if alert has an image
                    const hasImage = alert.imagePath && alert.imagePath !== "/images/no-image.png";

                    // Get the organization name from the alert with proper fallbacks
                    const organizationName = alert.displayOrganizationName || 
                                          alert.organizationName || 
                                          alert.issuedBy || 
                                          (alert.user && alert.user.OrganizationName) || 
                                          "Organization";

                    div.innerHTML = `
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="avatar-circle me-3">
                                    <i class="fas fa-bell"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0">
                                        <span class="text-danger">${organizationName}</span>
                                    </h6>
                                    <small class="text-muted">${formattedDate}</small>
                                </div>
                                <div class="post-type">
                                    <span class="badge rounded-pill ${badgeClass}">
                                        <i class="fas fa-bell me-1"></i>${severityText} Alert
                                    </span>
                                </div>
                            </div>

                            <h5 class="mb-3">${alert.title}</h5>

                            <div class="post-content mb-3">
                                <p class="card-text mb-0">${alert.message}</p>
                            </div>

                            ${hasImage ? `
                                <div class="post-image mb-3">
                                    <img src="${alert.imagePath}" class="img-fluid rounded" alt="" 
                                         onclick="openImageViewer(this.src)" style="cursor: pointer;">
                                </div>
                            ` : ''}

                            ${alert.affectedArea ? `
                                <div class="mb-2">
                                    <i class="fas fa-map-marker-alt text-muted me-2"></i>
                                    <span class="text-muted">Affected Area: </span>
                                    ${alert.affectedArea}
                                </div>
                            ` : ''}
                        </div>
                    `;
                        
                    return div;
                } catch (error) {
                    console.error("Error creating alert element:", error);
                    return null;
                }
            }

            // Helper function to get severity badge class
            function getSeverityBadgeClass(severity) {
                switch (severity) {
                    case 0: return 'bg-info'; // Info - Blue
                    case 1: return 'bg-warning'; // Warning - Yellow
                    case 2: return 'bg-danger'; // Danger - Red
                    case 3: return 'bg-dark'; // Critical - Black
                    default: return 'bg-info';
                }
            }

            // Start the connection and load existing alerts
            alertConnection.start()
                .then(() => {
                    console.log("SignalR Connected to AlertHub");
                    // Load existing alerts
                    loadExistingAlerts();
                    // Verify connection is working
                    alertConnection.invoke("PingConnection")
                        .then(response => {
                            console.log("Connection verified:", response);
                        })
                        .catch(err => {
                            console.error("Error verifying connection:", err);
                        });
                })
                .catch(err => console.error("Error connecting to AlertHub:", err));
            
            // Search functionality
            $('#post-search').on('input', function() {
                const searchTerm = $(this).val().toLowerCase();
                $('.post-card').each(function() {
                    const postContent = $(this).text().toLowerCase();
                    $(this).toggle(postContent.includes(searchTerm));
                });
            });

            // Filter functionality
            $('#post-filter').on('change', function() {
                const filter = $(this).val();
                $('.post-card').each(function() {
                    const postType = $(this).data('post-type');
                    if (filter === 'all' || postType === filter) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Update submit button color and placeholder text based on selected post type
            $('#modalType').on('change', function() {
                const postType = $(this).val();
                const $submitBtn = $('#submit-post-btn');
                const $textarea = $('#modalContent');
                
                // Remove all color classes
                $submitBtn.removeClass('btn-primary btn-danger btn-success btn-info btn-warning');
                
                // Add appropriate color class and placeholder based on post type
                switch(postType) {
                    case 'HelpRequest':
                        $submitBtn.addClass('btn-danger');
                        $submitBtn.css('background', 'linear-gradient(45deg, #dc3545, #c82333)');
                        $textarea.attr('placeholder', 
                            'Describe what help you need:\n' +
                            '• What type of assistance do you require?\n' +
                            '• How urgent is your need?\n' +
                            '• What resources or skills are needed?\n' +
                            '• Are there any specific requirements?'
                        );
                        break;
                    case 'StatusUpdate':
                        $submitBtn.addClass('btn-warning');
                        $submitBtn.css('background', 'linear-gradient(45deg, #ffc107, #e0a800)');
                        $textarea.attr('placeholder', 
                            'Share your current status:\n' +
                            '• What is the current situation?\n' +
                            '• Are there any changes or developments?\n' +
                            '• What impact does this have?\n' +
                            '• Any specific actions being taken?'
                        );
                        break;
                    case 'ResourceSharing':
                        $submitBtn.addClass('btn-success');
                        $submitBtn.css('background', 'linear-gradient(45deg, #28a745, #218838)');
                        $textarea.attr('placeholder', 
                            'Share available resources:\n' +
                            '• What resources are you sharing?\n' +
                            '• How can others access these resources?\n' +
                            '• Are there any conditions or requirements?\n' +
                            '• What is the availability period?'
                        );
                        break;
                    case 'Information':
                        $submitBtn.addClass('btn-info');
                        $submitBtn.css('background', 'linear-gradient(45deg, #17a2b8, #138496)');
                        $textarea.attr('placeholder', 
                            'Share important information:\n' +
                            '• What is the key information?\n' +
                            '• Who does this affect?\n' +
                            '• When is this relevant?\n' +
                            '• Are there any actions required?'
                        );
                        break;
                    default:
                        $submitBtn.addClass('btn-primary');
                        $submitBtn.css('background', 'linear-gradient(45deg, #4361ee, #4895ef)');
                        $textarea.attr('placeholder', 
                            'Share with the community:\n' +
                            '• What would you like to share?\n' +
                            '• Why is this important?\n' +
                            '• Who might find this useful?\n' +
                            '• Any additional context?'
                        );
                }
                
                // Reset box shadow for the button
                $submitBtn.css('box-shadow', '0 2px 5px rgba(0, 0, 0, 0.2)');
                
                // Trigger the placeholder to update visually
                $textarea.trigger('focus').trigger('blur');
            });
            
            // Trigger change event on page load to set initial placeholder and button style
            $('#modalType').trigger('change');
            
            // Add hover effect for the submit button
            $('#submit-post-btn').hover(
                function() {
                    $(this).css('transform', 'translateY(-2px)');
                    $(this).css('box-shadow', '0 4px 10px rgba(0, 0, 0, 0.3)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                    $(this).css('box-shadow', '0 2px 5px rgba(0, 0, 0, 0.2)');
                }
            );

            // Chat Robot Widget Functionality
            if ($('#chatRobotWindow').length) {
                const chatRobotWindow = document.getElementById('chatRobotWindow');
                const chatRobotClose = document.getElementById('chatRobotClose');
                const chatRobotInput = document.getElementById('chatRobotInput');
                const chatRobotSend = document.getElementById('chatRobotSend');
                const chatRobotBody = document.getElementById('chatRobotBody');

                // Add welcome message
                addMessage("Hi! I'm the THYNK Assistant powered by Google's Gemini AI. How can I help you today?", 'bot');

                function addMessage(text, sender) {
                    const messageDiv = document.createElement('div');
                    messageDiv.className = `chat-robot-message chat-robot-message-${sender}`;
                    
                    if (sender === 'bot') {
                        // Show typing indicator
                        const typingDiv = document.createElement('div');
                        typingDiv.className = 'chat-robot-message chat-robot-message-bot';
                        typingDiv.innerHTML = `
                            <div class="chat-robot-message-content">
                                <div class="typing-indicator">
                                    <span></span><span></span><span></span>
                                </div>
                            </div>`;
                        chatRobotBody.appendChild(typingDiv);
                        chatRobotBody.scrollTop = chatRobotBody.scrollHeight;
                        
                        // Simulate typing delay
                        setTimeout(() => {
                            typingDiv.remove();
                            messageDiv.innerHTML = `<div class="chat-robot-message-content">${formatMessage(text)}</div>`;
                            chatRobotBody.appendChild(messageDiv);
                            chatRobotBody.scrollTop = chatRobotBody.scrollHeight;
                        }, 1000);
                    } else {
                        messageDiv.innerHTML = `<div class="chat-robot-message-content">${formatMessage(text)}</div>`;
                        chatRobotBody.appendChild(messageDiv);
                        chatRobotBody.scrollTop = chatRobotBody.scrollHeight;
                    }
                }

                function formatMessage(text) {
                    return text
                        .replace(/\n/g, '<br>')
                        .replace(/•/g, '&#8226;')
                        .replace(/□/g, '&#9744;')
                        .replace(/✓/g, '&#10004;');
                }

                async function getGeminiResponse(message) {
                    try {
                        const response = await fetch('/api/ChatBot/ask', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ message: message })
                        });

                        const data = await response.json();

                        if (!response.ok) {
                            console.error('API Error:', data.error);
                            throw new Error(data.error || 'Failed to get response');
                        }

                        return data.response;
                    } catch (error) {
                        console.error('Error:', error);
                        return `I apologize, but I encountered an error: ${error.message}. Please try again later.`;
                    }
                }

                // Send message function
                async function sendMessage() {
                    const msg = chatRobotInput.value.trim();
                    if (!msg) return;
                    
                    // Disable input and button while processing
                    chatRobotInput.disabled = true;
                    chatRobotSend.disabled = true;
                    
                    try {
                        // Add user message
                        addMessage(msg, 'user');
                        chatRobotInput.value = '';
                        
                        // Get and display bot response
                        const response = await getGeminiResponse(msg);
                        addMessage(response, 'bot');
                    } catch (error) {
                        console.error('Error in sendMessage:', error);
                        addMessage('I apologize, but I encountered an error. Please try again later.', 'bot');
                    } finally {
                        // Re-enable input and button
                        chatRobotInput.disabled = false;
                        chatRobotSend.disabled = false;
                        chatRobotInput.focus();
                    }
                }

                // Send button click
                chatRobotSend.addEventListener('click', sendMessage);

                // Enter key press
                chatRobotInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        sendMessage();
                    }
                });

                // Sample question clicks
                $('.sample-question').on('click', async function() {
                    const question = $(this).data('question');
                    chatRobotInput.value = question;
                    await sendMessage();
                });
            }

            // Add this to your existing document.ready function
            const chatBotButton = document.getElementById('chatBotButton');
            const chatRobotWindow = document.getElementById('chatRobotWindow');

            chatBotButton.addEventListener('click', function() {
                chatRobotWindow.style.display = 'flex';
                chatBotButton.style.display = 'none';
            });

            document.getElementById('chatRobotClose').addEventListener('click', function() {
                chatRobotWindow.style.display = 'none';
                chatBotButton.style.display = 'flex';
            });
        });

        // Function to handle post submission confirmation
        function confirmPost() {
            const postContent = document.getElementById('modalContent').value;
            const postType = document.getElementById('modalType').value;
            
            if (!postContent.trim()) {
                showToastNotification(
                    "Error",
                    "Please enter some content for your post",
                    "warning"
                );
                return false;
            }

            // Show confirmation modal
            const confirmModal = new bootstrap.Modal(document.getElementById('postConfirmModal'));
            confirmModal.show();

            // Set up confirmation button
            document.getElementById('confirmPostBtn').onclick = function() {
                // Submit the form
                document.querySelector('.create-post-form').submit();
                // Hide the confirmation modal
                confirmModal.hide();
            };

            // Set up edit button
            document.getElementById('editPostBtn').onclick = function() {
                confirmModal.hide();
            };

            return false; // Prevent form submission until confirmed
        }

        // Function to show toast notification
        function showToastNotification(title, message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast-notification ${type}`;
            
            // Get appropriate icon based on type
            let icon = 'info-circle';
            if (type === 'success') icon = 'check-circle';
            else if (type === 'warning') icon = 'exclamation-circle';
            else if (type === 'danger') icon = 'exclamation-triangle';
            else if (type === 'critical') icon = 'radiation';
            
            toast.innerHTML = `
                <div class="toast-header">
                    <i class="fas fa-${icon}"></i>
                    <strong class="ms-2">${title}</strong>
                </div>
                <div class="toast-body">
                    ${message}
                </div>
            `;
            document.body.appendChild(toast);

            // Remove toast after 5 seconds
            setTimeout(() => {
                toast.classList.add('hide');
                setTimeout(() => toast.remove(), 300);
            }, 5000);
        }

        // Image preview functionality
        document.getElementById('modalImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file size
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    this.value = '';
                    return;
                }

                // Validate file type
                if (!['image/jpeg', 'image/jpg', 'image/png', 'image/gif'].includes(file.type.toLowerCase())) {
                    alert('Only JPEG, PNG, and GIF images are allowed');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.querySelector('#imagePreview');
                    const img = preview.querySelector('img');
                    img.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        });

        // Remove image preview
        function removeImage() {
            const input = document.getElementById('modalImage');
            input.value = '';
            const preview = document.getElementById('imagePreview');
            preview.classList.add('d-none');
            preview.querySelector('img').src = '';
        }

        // Location detection
        document.getElementById('detect-modal-location').addEventListener('click', function() {
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(function(position) {
                    const latitude = position.coords.latitude;
                    const longitude = position.coords.longitude;
                    
                    // Update hidden fields
                    document.getElementById('modalLatitude').value = latitude;
                    document.getElementById('modalLongitude').value = longitude;
                    
                    // Reverse geocoding using Nominatim
                    fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}`)
                        .then(response => response.json())
                        .then(data => {
                            const location = data.display_name.split(',').slice(0, 3).join(',');
                            document.getElementById('modalLocation').value = location;
                        })
                        .catch(error => {
                            console.error('Error getting location:', error);
                            alert('Could not get location name. Please enter it manually.');
                        });
                }, function(error) {
                    console.error('Error getting location:', error);
                    alert('Could not detect location. Please enter it manually.');
                });
            } else {
                alert('Location detection is not supported by your browser. Please enter location manually.');
            }
        });

        // Form validation before submit
        document.querySelector('form.create-post-form').addEventListener('submit', function(e) {
            const location = document.getElementById('modalLocation').value.trim();
            const image = document.getElementById('modalImage').files[0];
            
            if (!location) {
                e.preventDefault();
                alert('Please specify a location for your post.');
                return;
            }
            
            if (!image) {
                e.preventDefault();
                alert('Please upload an image with your post.');
                return;
            }
        });
    </script>
    <script src="/js/community-attachment.js"></script>
} 